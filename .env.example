DATABASE_URL=postgres://sanitation:sanitation@127.0.0.1:5432/sanitation?sslmode=disable
LISTEN_ADDRESS=127.0.0.1:8080
PUBLIC_ORIGIN=https://localhost:8080
# Generate at least 32 random bytes, encoded as base64. Do not use a fixed secret.
CSRF_SECRET=
SESSION_TTL=720h
REQUEST_TIMEOUT=10s
RATE_WINDOW=1m
RATE_LIMIT=30
# Comma-separated trusted proxy IP addresses or CIDRs. Empty trusts no proxies.
TRUSTED_PROXIES=
