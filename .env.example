# Local PostgreSQL from compose.yaml; never use these credentials in production.
DATABASE_URL='postgres://sanitation:sanitation@127.0.0.1:5432/sanitation?sslmode=disable'

# HTTP backend behind an HTTPS reverse proxy. Use distinct proxy/backend ports.
LISTEN_ADDRESS='127.0.0.1:8080'
PUBLIC_ORIGIN='https://localhost:8080'
TRUSTED_PROXIES=''

# Required: standard base64 encoding of at least 32 random bytes.
# Generate with: openssl rand -base64 32
OTP_HMAC_SECRET=''
OTP_TTL='10m'
OTP_MAX_ATTEMPTS='5'
OTP_RESEND_INTERVAL='1m'
OTP_LOCKOUT='15m'
SESSION_TTL='720h'

REQUEST_TIMEOUT='10s'
SMTP_TIMEOUT='10s'
RATE_WINDOW='1m'
RATE_LIMIT='30'
SLOT_STEP='15m'

# Required endpoint/sender placeholders; replace with your TLS-capable SMTP service.
# Port 465: implicit TLS. All other ports: mandatory STARTTLS.
SMTP_ADDRESS='smtp.example.com:587'
SMTP_FROM='sanitation@example.com'
# Supply both authentication values or leave both empty.
SMTP_USERNAME=''
SMTP_PASSWORD=''

# Optional test-only URL. Tests create/drop schemas; never target production.
DATABASE_TEST_URL='postgres://sanitation:sanitation@127.0.0.1:5432/sanitation?sslmode=disable'
