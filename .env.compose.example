# Production: your DNS hostname. Development override: localhost.
CADDY_DOMAIN=barone.example.com
ACME_EMAIL=
# Optional: use https://acme-staging-v02.api.letsencrypt.org/directory for ACME tests.
# ACME_CA=

# Generate with openssl rand -hex 32. Must match the existing volume's password.
POSTGRES_PASSWORD=
# Generate with openssl rand -base64 32. Keep it across container restarts.
OTP_HMAC_SECRET=

# Production requires SMTP. compose.dev.yaml selects console instead.
OTP_PROVIDER=smtp
SMTP_ADDRESS=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
PRICE_CURRENCY=USD

# Dev only: existing certificate and key, mounted read-only into Caddy.
TLS_CERT_FILE=./frontend/.tls/localhost.crt
TLS_KEY_FILE=./frontend/.tls/localhost.key
